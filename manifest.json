{
  "manifest_version": 3,
  "name": "Momento Image Saver",
  "description": "Adds a Chrome image context menu action that imports the image into Momento.",
  "version": "0.1.0",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:47641/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://instagram.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "instagram-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://xiaohongshu.com/explore/*",
        "https://www.xiaohongshu.com/explore/*"
      ],
      "js": [
        "xiaohongshu-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
